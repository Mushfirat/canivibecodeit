<section class="waitlist wrap reveal" id="waitlist">
  <h2>Next: scan your codebase, kill your stack's subscriptions.</h2>
  <p class="sub">
    One prompt finds everything you could stop paying for. Get it first.
  </p>
  <form method="post" action="/api/waitlist" data-waitlist>
    <label class="hp" aria-hidden="true">
      Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <input
      type="email"
      name="email"
      required
      placeholder="you@example.com"
      aria-label="Email address"
    />
    <button class="btn primary" type="submit">notify me</button>
  </form>
</section>
